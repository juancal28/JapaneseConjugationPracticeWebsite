{
  "name": "japanese-custom-conjugator-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:jmdict": "tsx scripts/setup-jmdict.ts",
    "builtin:build": "tsx scripts/build-builtin.ts",
    "keys:rebuild": "tsx scripts/rebuild-keys.ts",
    "fixture:reference": "tsx scripts/reference-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.15.0",
    "tsx": "^4.23.15",
    "typography": "^0.16.24",
    "typography-theme-bootstrap": "^0.16.19",
    "wanakana": "4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/typography": "^0.16.9",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
